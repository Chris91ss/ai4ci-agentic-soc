{
  "additionalProperties": false,
  "description": "Process launch reported by the endpoint agent (OCSF 1007).",
  "properties": {
    "event_id": {
      "maxLength": 64,
      "minLength": 8,
      "title": "Event Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_time": {
      "description": "Time recorded by the source clock (may be skewed).",
      "format": "date-time",
      "title": "Event Time",
      "type": "string"
    },
    "source": {
      "description": "Producing system or sensor.",
      "maxLength": 64,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "host": {
      "description": "Host FQDN as reported by the EDR.",
      "maxLength": 128,
      "minLength": 1,
      "title": "Host",
      "type": "string"
    },
    "user": {
      "description": "DOMAIN\\account of the process.",
      "maxLength": 128,
      "minLength": 1,
      "title": "User",
      "type": "string"
    },
    "pid": {
      "minimum": 0,
      "title": "Pid",
      "type": "integer"
    },
    "ppid": {
      "minimum": 0,
      "title": "Ppid",
      "type": "integer"
    },
    "process_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Process Name",
      "type": "string"
    },
    "parent_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Parent Name",
      "type": "string"
    },
    "command_line": {
      "default": "",
      "maxLength": 2048,
      "title": "Command Line",
      "type": "string"
    },
    "image_path": {
      "default": "",
      "maxLength": 512,
      "title": "Image Path",
      "type": "string"
    },
    "integrity": {
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high",
        "system"
      ],
      "title": "Integrity",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_time",
    "source",
    "host",
    "user",
    "pid",
    "ppid",
    "process_name",
    "parent_name"
  ],
  "title": "ProcessEvent",
  "type": "object"
}
