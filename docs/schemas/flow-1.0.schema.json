{
  "additionalProperties": false,
  "description": "Bidirectional flow record from a network sensor or the perimeter firewall (OCSF 4001).",
  "properties": {
    "event_id": {
      "maxLength": 64,
      "minLength": 8,
      "title": "Event Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_time": {
      "description": "Time recorded by the source clock (may be skewed).",
      "format": "date-time",
      "title": "Event Time",
      "type": "string"
    },
    "source": {
      "description": "Producing system or sensor.",
      "maxLength": 64,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "src_ip": {
      "title": "Src Ip",
      "type": "string"
    },
    "src_port": {
      "maximum": 65535,
      "minimum": 0,
      "title": "Src Port",
      "type": "integer"
    },
    "dst_ip": {
      "title": "Dst Ip",
      "type": "string"
    },
    "dst_port": {
      "maximum": 65535,
      "minimum": 0,
      "title": "Dst Port",
      "type": "integer"
    },
    "protocol": {
      "enum": [
        "tcp",
        "udp",
        "icmp"
      ],
      "title": "Protocol",
      "type": "string"
    },
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "bytes_out": {
      "description": "Bytes sent from source to destination.",
      "minimum": 0,
      "title": "Bytes Out",
      "type": "integer"
    },
    "bytes_in": {
      "description": "Bytes sent from destination to source.",
      "minimum": 0,
      "title": "Bytes In",
      "type": "integer"
    },
    "packets_out": {
      "default": 0,
      "minimum": 0,
      "title": "Packets Out",
      "type": "integer"
    },
    "packets_in": {
      "default": 0,
      "minimum": 0,
      "title": "Packets In",
      "type": "integer"
    },
    "fw_action": {
      "default": "allowed",
      "enum": [
        "allowed",
        "blocked"
      ],
      "title": "Fw Action",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_time",
    "source",
    "src_ip",
    "src_port",
    "dst_ip",
    "dst_port",
    "protocol",
    "duration_ms",
    "bytes_out",
    "bytes_in"
  ],
  "title": "NetworkFlowEvent",
  "type": "object"
}
